# ==============================================================================
# Goto IM 开发环境配置 (.env.development)
# 注意：请勿在此提交敏感生产秘钥。
# 启动命令：flutter run --dart-define=APP_ENV=development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础应用信息
# ------------------------------------------------------------------------------
# 应用名称
APP_NAME="Goto IM"

# 应用唯一标识（兼容原有 UniApp 项目应用 ID）
APP_ID="__UNI__39F095D"

# 应用版本号
APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. 业务 API 网关与服务地址
# ------------------------------------------------------------------------------
# 后端业务主 API 基础地址（ABP vNext 业务 API 网关，所有 /api/** 请求的 BaseUrl）
API_BASE_URL="http://10.0.5.20:8044"

# 设备管理服务专用 BaseUrl（留空则默认复用 API_BASE_URL）
# APP_DEVICE_BASE_URL="http://10.0.5.20:8044"

# 客户端设备注册接口路径
DEVICE_REGISTRATION_API_PATH="/api/app-device/public/device-public/register"

# 朋友圈 / 社交独立服务 BaseUrl（留空则默认复用 API_BASE_URL 网关）
# SOCIAL_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 3. 统一认证授权服务 (OpenIddict)
# ------------------------------------------------------------------------------
# 认证授权服务器基础地址（处理 /connect/** 请求，与业务网关相互独立）
AUTH_BASE_URL="http://10.0.5.20:8043"

# 获取与刷新 Token 接口路径
AUTH_TOKEN_PATH="/connect/token"

# 客户端应用 ID (Client ID)
AUTH_CLIENT_ID="IM_Mobile"

# 客户端秘钥 (Client Secret)
AUTH_CLIENT_SECRET="1q2w3e*"

# OAuth 授权作用域 Scope 列表（空格分隔）
AUTH_SCOPE="IM Chat Cms Social AppStatistic AppDevice offline_access roles profile phone email address"

# 当前登录用户信息接口路径
AUTH_USER_INFO_PATH="/connect/userinfo"

# 登录授权模式：默认为账号密码模式 "password"；支持单点登录或自定义模式（如 "erp-token"）
# AUTH_LOGIN_GRANT_TYPE="erp-token"
AUTH_LOGIN_GRANT_TYPE="password"

# Token 检查与内省接口路径（可选）
AUTH_INTROSPECTION_PATH="/connect/introspect"

# Token 撤销接口路径（兼容后端非标路径 /connect/revocat）
AUTH_REVOCATION_PATH="/connect/revocat"

# ------------------------------------------------------------------------------
# 4. 即时通讯与长连接 (SignalR Realtime)
# ------------------------------------------------------------------------------
# SignalR 实时服务基础地址
SIGNALR_BASE_URL="http://10.0.5.20:8044"

# 聊天消息实时通道 Hub 路径
SIGNALR_HUB_PATH="/signalr-hubs/chat"

# 是否跳过 HTTP 协商直接建立 WebSocket 连接（true 可减少 1 次网络往返，加速连接）
SIGNALR_SKIP_NEGOTIATION=true

# 掉线自动重连阶梯延时列表（毫秒，逗号分隔：首次断线立即重连，随后 2s、10s、30s）
SIGNALR_RECONNECT_DELAYS_MS="0,2000,10000,30000"

# 业务在线状态心跳上报间隔（秒，定时刷新 Redis 在线状态）
PRESENCE_HEARTBEAT_INTERVAL_SECONDS=10

# 好友在线状态最小拉取刷新间隔（秒）
FRIEND_PRESENCE_REFRESH_MIN_INTERVAL_SECONDS=10

# ------------------------------------------------------------------------------
# 5. 扫码登录 (Scan Code Login)
# ------------------------------------------------------------------------------
# 扫码登录专用 SignalR 服务地址
SCAN_LOGIN_SIGNALR_BASE_URL="http://10.0.5.20:8044"

# 扫码登录专用 SignalR Hub 路由路径
SCAN_LOGIN_HUB_PATH="/scan-login/hub"

# 扫码二维码 Schema 深度链接模板
SCAN_LOGIN_TEMPLATE="gotoim://scan-login?code={code}"

# 二维码有效时长（秒，默认 90 秒）
SCAN_LOGIN_QR_EXPIRES_SECONDS=90

# 扫码确认认证服务 BaseUrl
SCAN_LOGIN_AUTH_BASE_URL="http://10.0.5.20:8043"

# 扫码换取 Token 接口路径
SCAN_LOGIN_AUTH_TOKEN_PATH="/connect/token"

# 扫码登录客户端 Client ID
SCAN_LOGIN_AUTH_CLIENT_ID="IM_Mobile"

# 扫码登录客户端 Client Secret
SCAN_LOGIN_AUTH_CLIENT_SECRET="1q2w3e*"

# 扫码登录授权作用域 Scope
SCAN_LOGIN_AUTH_SCOPE="IM"

# ------------------------------------------------------------------------------
# 6. 混合开发与 JSBridge 联调
# ------------------------------------------------------------------------------
# 独立 H5 原生能力诊断联调测试页地址
JS_BRIDGE_HARNESS_URL="http://10.0.5.20:4173"

# 原生 Bridge 文件上传联调测试目标地址
JS_BRIDGE_UPLOAD_URL="http://10.0.5.20:4173/upload"

# 允许通过 H5 JSBridge 进行上传的白名单域名列表（逗号分隔）
JS_BRIDGE_UPLOAD_ALLOWED_HOSTS="10.0.5.20,127.0.0.1,localhost"

# ------------------------------------------------------------------------------
# 7. 深度链接与埋点统计 (Deep Link & Statistics)
# ------------------------------------------------------------------------------
# 允许唤起 App 的自定义 URL Scheme 协议头（逗号分隔）
DEEP_LINK_SCHEMES="gotoim-dev,gotoim"

# 允许的通用链接 / App Link 域名白名单（逗号分隔）
DEEP_LINK_ALLOWED_HOSTS="gotoim.com"

# 数据埋点与客户端性能统计服务 API BaseUrl
STATISTIC_BASE_URL="http://10.0.5.20:51621"

# ------------------------------------------------------------------------------
# 8. 调试与日志
# ------------------------------------------------------------------------------
# 是否在控制台输出详细 HTTP/网络请求日志（开发环境建议开启 true，生产环境关闭 false）
ENABLE_NETWORK_LOGGING=true
