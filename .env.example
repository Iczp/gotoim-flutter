# Copy to .env.local only for tooling that explicitly supports local overrides.
# The app selects .env.development, .env.staging, or .env.production with:
# flutter run --dart-define=APP_ENV=development
APP_ID=__UNI__39F095D
APP_NAME=Goto IM
APP_VERSION=1.0.0
API_BASE_URL=https://api.example.invalid
AUTH_BASE_URL=https://auth.example.invalid
AUTH_TOKEN_PATH=/connect/token
AUTH_CLIENT_ID=gotoim-mobile
AUTH_CLIENT_SECRET=
AUTH_SCOPE=openid profile offline_access
AUTH_LOGIN_GRANT_TYPE=password
AUTH_USER_INFO_PATH=/connect/userinfo
AUTH_INTROSPECTION_PATH=/connect/introspect
# Existing UniApp backend uses this non-standard path; do not change without backend confirmation.
AUTH_REVOCATION_PATH=/connect/revocat
SIGNALR_BASE_URL=https://signalr.example.invalid
SIGNALR_HUB_PATH=/signalr-hubs/chat
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_RECONNECT_DELAYS_MS=0,2000,10000,30000
ENABLE_NETWORK_LOGGING=false
