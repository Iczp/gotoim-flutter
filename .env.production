# Production endpoints. Do not put secrets in this file.
API_BASE_URL=https://api.example.invalid
AUTH_BASE_URL=https://auth.example.invalid
AUTH_TOKEN_PATH=/connect/token
AUTH_CLIENT_ID=gotoim-mobile
AUTH_CLIENT_SECRET=
AUTH_SCOPE=openid profile offline_access
AUTH_LOGIN_GRANT_TYPE=password
AUTH_USER_INFO_PATH=/connect/userinfo
SIGNALR_BASE_URL=https://signalr.example.invalid
SIGNALR_HUB_PATH=/signalr-hubs/chat
SCAN_LOGIN_HUB_PATH=/signalr-hubs/scan-login
SCAN_LOGIN_SIGNALR_BASE_URL=https://signalr.example.invalid
SCAN_LOGIN_TEMPLATE=gotoim://scan-login?code={code}
SCAN_LOGIN_QR_EXPIRES_SECONDS=90
SCAN_LOGIN_AUTH_BASE_URL=https://auth.example.invalid
SCAN_LOGIN_AUTH_TOKEN_PATH=/connect/token
SCAN_LOGIN_AUTH_CLIENT_ID=IM_Mobile
SCAN_LOGIN_AUTH_CLIENT_SECRET=
SCAN_LOGIN_AUTH_SCOPE=IM
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_RECONNECT_DELAYS_MS=0,2000,10000,30000
JS_BRIDGE_HARNESS_URL=
JS_BRIDGE_UPLOAD_URL=
JS_BRIDGE_UPLOAD_ALLOWED_HOSTS=
ENABLE_NETWORK_LOGGING=false
